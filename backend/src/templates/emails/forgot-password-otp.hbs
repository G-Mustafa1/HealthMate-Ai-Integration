<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <title>Password reset</title>
</head>

<body
    style="
        margin:0;
        padding:0;
        background:#f8fafc;
        font-family:Arial,Helvetica,sans-serif;
        color:#0f172a;
    "
>
    <table
        width="100%"
        cellpadding="0"
        cellspacing="0"
        style="padding:40px 16px;"
    >
        <tr>
            <td align="center">

                <table
                    width="100%"
                    cellpadding="0"
                    cellspacing="0"
                    style="
                        max-width:560px;
                        background:#ffffff;
                        border:1px solid #e2e8f0;
                        border-radius:20px;
                        overflow:hidden;
                    "
                >

                    <tr>
                        <td
                            style="
                                padding:28px 32px;
                                background:#0f766e;
                            "
                        >
                            <div
                                style="
                                    color:#ffffff;
                                    font-size:24px;
                                    font-weight:700;
                                "
                            >
                                HealthMate
                            </div>

                            <div
                                style="
                                    margin-top:6px;
                                    color:#ccfbf1;
                                    font-size:13px;
                                "
                            >
                                Your smart health companion
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding:36px 32px;">

                            <h1
                                style="
                                    margin:0 0 12px;
                                    font-size:24px;
                                "
                            >
                                Reset your password
                            </h1>

                            <p
                                style="
                                    margin:0 0 24px;
                                    color:#64748b;
                                    font-size:15px;
                                    line-height:1.7;
                                "
                            >
                                We received a request to reset your
                                HealthMate account password. Use the
                                verification code below to continue.
                            </p>

                            <div
                                style="
                                    text-align:center;
                                    margin:30px 0;
                                "
                            >
                                <div
                                    style="
                                        display:inline-block;
                                        padding:17px 30px;
                                        background:#f0fdfa;
                                        border:1px solid #99f6e4;
                                        border-radius:14px;
                                        color:#0f766e;
                                        font-size:32px;
                                        font-weight:700;
                                        letter-spacing:8px;
                                    "
                                >
                                    {{otp}}
                                </div>
                            </div>

                            <p
                                style="
                                    margin:0;
                                    text-align:center;
                                    color:#64748b;
                                    font-size:13px;
                                "
                            >
                                This code expires in
                                <strong>{{expiresIn}} minutes</strong>.
                            </p>

                            <div
                                style="
                                    margin-top:28px;
                                    padding:16px;
                                    background:#fff7ed;
                                    border:1px solid #fed7aa;
                                    border-radius:12px;
                                    color:#9a3412;
                                    font-size:13px;
                                    line-height:1.6;
                                "
                            >
                                <strong>Didn't request a password reset?</strong>
                                <br />
                                You can safely ignore this email. Your
                                password will remain unchanged.
                            </div>

                        </td>
                    </tr>

                    <tr>
                        <td
                            style="
                                padding:20px 32px;
                                background:#f8fafc;
                                border-top:1px solid #e2e8f0;
                                text-align:center;
                            "
                        >
                            <p
                                style="
                                    margin:0;
                                    color:#94a3b8;
                                    font-size:12px;
                                "
                            >
                                © {{year}} HealthMate. All rights reserved.
                            </p>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>
</body>
</html>
