<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <title>Password changed</title>
</head>

<body
    style="
        margin:0;
        padding:0;
        background:#f8fafc;
        font-family:Arial,Helvetica,sans-serif;
        color:#0f172a;
    "
>
    <table
        width="100%"
        cellpadding="0"
        cellspacing="0"
        style="padding:40px 16px;"
    >
        <tr>
            <td align="center">

                <table
                    width="100%"
                    cellpadding="0"
                    cellspacing="0"
                    style="
                        max-width:560px;
                        background:#ffffff;
                        border:1px solid #e2e8f0;
                        border-radius:20px;
                        overflow:hidden;
                    "
                >

                    <tr>
                        <td
                            style="
                                padding:28px 32px;
                                background:#0f766e;
                            "
                        >
                            <div
                                style="
                                    color:#ffffff;
                                    font-size:24px;
                                    font-weight:700;
                                "
                            >
                                HealthMate
                            </div>

                            <div
                                style="
                                    margin-top:6px;
                                    color:#ccfbf1;
                                    font-size:13px;
                                "
                            >
                                Your smart health companion
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding:36px 32px;">

                            <div
                                style="
                                    width:52px;
                                    height:52px;
                                    line-height:52px;
                                    text-align:center;
                                    background:#ecfdf5;
                                    color:#059669;
                                    border-radius:14px;
                                    font-size:24px;
                                "
                            >
                                ✓
                            </div>

                            <h1
                                style="
                                    margin:22px 0 12px;
                                    font-size:24px;
                                "
                            >
                                Password changed successfully
                            </h1>

                            <p
                                style="
                                    margin:0;
                                    color:#64748b;
                                    font-size:15px;
                                    line-height:1.7;
                                "
                            >
                                Your HealthMate account password has been
                                successfully updated.
                            </p>

                            <div
                                style="
                                    margin-top:28px;
                                    padding:16px;
                                    background:#fef2f2;
                                    border:1px solid #fecaca;
                                    border-radius:12px;
                                    color:#b91c1c;
                                    font-size:13px;
                                    line-height:1.6;
                                "
                            >
                                <strong>Didn't make this change?</strong>
                                <br />
                                Please secure your account immediately and
                                contact support if you believe your account
                                has been compromised.
                            </div>

                            <p
                                style="
                                    margin:28px 0 0;
                                    color:#64748b;
                                    font-size:13px;
                                    line-height:1.6;
                                "
                            >
                                For your security, never share your password
                                or verification codes with anyone.
                            </p>

                        </td>
                    </tr>

                    <tr>
                        <td
                            style="
                                padding:20px 32px;
                                background:#f8fafc;
                                border-top:1px solid #e2e8f0;
                                text-align:center;
                            "
                        >
                            <p
                                style="
                                    margin:0;
                                    color:#94a3b8;
                                    font-size:12px;
                                "
                            >
                                © {{year}} HealthMate. All rights reserved.
                            </p>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>
</body>
</html>
