<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <title>New login</title>
</head>

<body
    style="
        margin:0;
        padding:0;
        background:#f8fafc;
        font-family:Arial,Helvetica,sans-serif;
        color:#0f172a;
    "
>
    <table
        width="100%"
        cellpadding="0"
        cellspacing="0"
        style="padding:40px 16px;"
    >
        <tr>
            <td align="center">

                <table
                    width="100%"
                    cellpadding="0"
                    cellspacing="0"
                    style="
                        max-width:560px;
                        background:#ffffff;
                        border:1px solid #e2e8f0;
                        border-radius:20px;
                        overflow:hidden;
                    "
                >

                    <tr>
                        <td
                            style="
                                padding:28px 32px;
                                background:#0f766e;
                            "
                        >
                            <div
                                style="
                                    color:#ffffff;
                                    font-size:24px;
                                    font-weight:700;
                                "
                            >
                                HealthMate
                            </div>

                            <div
                                style="
                                    margin-top:6px;
                                    color:#ccfbf1;
                                    font-size:13px;
                                "
                            >
                                Account security notification
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding:36px 32px;">

                            <div
                                style="
                                    display:inline-block;
                                    padding:8px 12px;
                                    background:#ecfdf5;
                                    color:#047857;
                                    border-radius:999px;
                                    font-size:12px;
                                    font-weight:600;
                                "
                            >
                                New login detected
                            </div>

                            <h1
                                style="
                                    margin:18px 0 12px;
                                    font-size:24px;
                                "
                            >
                                Your account was accessed
                            </h1>

                            <p
                                style="
                                    margin:0;
                                    color:#64748b;
                                    font-size:15px;
                                    line-height:1.7;
                                "
                            >
                                Someone just signed in to your HealthMate
                                account.
                            </p>

                            <div
                                style="
                                    margin-top:28px;
                                    padding:18px;
                                    background:#f8fafc;
                                    border:1px solid #e2e8f0;
                                    border-radius:14px;
                                "
                            >
                                <p
                                    style="
                                        margin:0;
                                        color:#334155;
                                        font-size:14px;
                                        line-height:1.6;
                                    "
                                >
                                    If this was you, no further action is
                                    required.
                                </p>
                            </div>

                            <div
                                style="
                                    margin-top:18px;
                                    padding:16px;
                                    background:#fef2f2;
                                    border:1px solid #fecaca;
                                    border-radius:12px;
                                    color:#b91c1c;
                                    font-size:13px;
                                    line-height:1.6;
                                "
                            >
                                <strong>Wasn't you?</strong>
                                <br />
                                Change your password immediately and secure
                                your account.
                            </div>

                        </td>
                    </tr>

                    <tr>
                        <td
                            style="
                                padding:20px 32px;
                                background:#f8fafc;
                                border-top:1px solid #e2e8f0;
                                text-align:center;
                            "
                        >
                            <p
                                style="
                                    margin:0;
                                    color:#94a3b8;
                                    font-size:12px;
                                "
                            >
                                © {{year}} HealthMate. All rights reserved.
                            </p>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>
</body>
</html>
